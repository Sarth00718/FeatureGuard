# Copy to .env and change the passwords. NEVER commit .env.
POSTGRES_USER=featureguard
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=featureguard

# Drift monitoring (see README, "Validation vs drift")
DRIFT_ENGINE=evidently        # evidently | ks
DRIFT_BATCH_SIZE=30           # accepted requests collected before one drift check
DRIFT_SHARE_THRESHOLD=0.3     # alert if >= 30% of features drifted
LOG_LEVEL=INFO

# Grafana admin login
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-too

# Training from your host machine against the MLflow container
# MLFLOW_TRACKING_URI=http://localhost:5000
